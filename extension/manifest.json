{
  "manifest_version": 3,
  "name": "CodeSync",
  "version": "1.1.1",
  "description": "Detects accepted coding submissions on LeetCode, GeeksforGeeks, CodeChef and NeetCode, then syncs them into your GitHub repository.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CodeSync",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.codechef.com/*",
        "https://*.neetcode.io/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.codechef.com/*",
        "https://*.neetcode.io/*"
      ],
      "js": ["content/bridge-main.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
