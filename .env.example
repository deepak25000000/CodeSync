# CodeSync backend — copy to backend/.env and edit. NEVER commit real values.

# --- Core -------------------------------------------------------------------
# SQLite (default, zero external services) — fine for local dev and a VPS.
# For Render/ephemeral hosts use a hosted Postgres (Neon/Supabase free tier);
# the postgres:// URLs they give you are accepted as-is:
# DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./codesync.db
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Credential encryption --------------------------------------------------
# Fernet key (urlsafe base64, 32 bytes) OR any passphrase (derived via SHA-256).
# Generate one with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# --- GitHub OAuth app (optional; PAT flow works without it) -----------------
# Create at https://github.com/settings/developers
#   Homepage URL:            http://127.0.0.1:8000
#   Authorization callback:  http://127.0.0.1:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- GitHub API -------------------------------------------------------------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OAUTH_BASE_URL=https://github.com
GITHUB_TIMEOUT_SECONDS=15

# --- Sync worker ------------------------------------------------------------
SYNC_MAX_ATTEMPTS=5
SYNC_POLL_INTERVAL_SECONDS=2.0
SYNC_SCHEDULER_ENABLED=true

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Safety -----------------------------------------------------------------
MAX_REQUEST_BYTES=2000000
# Comma-separated origins for CORS (leave empty for same-origin/extension use)
CORS_ORIGINS=
